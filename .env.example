# ==============================================================================
# LORÉA LUXURY FASHION E-COMMERCE — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# INSTRUCTIONS:
# 1. Duplicate this file and rename it to ".env" (or ".env.local").
# 2. Populate the required values with your deployment credentials.
# 3. NEVER commit your actual ".env" file or private keys to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER CONFIGURATION
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production
SITE_URL=https://www.loreaofficial.com
DATABASE_URL=./lorea.db

# ------------------------------------------------------------------------------
# 2. SECURITY & AUTHENTICATION SECRETS (SERVER-SIDE ONLY)
# Never prefix with VITE_ to keep these inaccessible from client bundles
# ------------------------------------------------------------------------------
AUTH_SECRET=your_super_secret_high_entropy_auth_key_min_32_chars
JWT_SECRET=your_super_secret_high_entropy_jwt_key_min_32_chars
SESSION_EXPIRY_DAYS=7
COOKIE_DOMAIN=.loreaofficial.com

# ------------------------------------------------------------------------------
# 2.5. TRANSACTIONAL EMAIL & PASSWORD RECOVERY (SMTP / GMAIL / SENDGRID)
# Required to deliver real password reset verification emails and receipts
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=concierge@loreaofficial.com
SMTP_PASS=your_gmail_app_password_here
SMTP_FROM="LORÉA Haute Couture" <concierge@loreaofficial.com>

# ------------------------------------------------------------------------------
# 3. SUPABASE POSTGRESQL & HOSTED AUTHENTICATION (OPTIONAL HYBRID PERSISTENCE)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_never_expose

# ------------------------------------------------------------------------------
# 4. PAYMENT GATEWAY INTEGRATIONS (SERVER-SIDE VERIFICATION)
# ------------------------------------------------------------------------------
PAYMENT_PROVIDER=paymob
PAYMOB_API_KEY=your_paymob_api_key_secret
PAYMOB_INTEGRATION_ID=your_integration_id
PAYMOB_HMAC_SECRET=your_hmac_secret_for_webhook_signature
PAYMENT_WEBHOOK_SECRET=your_webhook_validation_secret

# ------------------------------------------------------------------------------
# 5. GOOGLE GEMINI AI (ATELIER VIRTUAL STYLIST & PHOTO TRY-ON)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key

# ------------------------------------------------------------------------------
# 6. CLIENT-SAFE PUBLIC CONFIGURATION (EXPOSED TO BROWSER)
# Only variables prefixed with VITE_ are included in the Vite client bundle
# ------------------------------------------------------------------------------
VITE_SITE_URL=https://www.loreaofficial.com
VITE_API_URL=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
