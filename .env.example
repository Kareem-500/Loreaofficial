# ==============================================================================
# LORÉA — Secure environment template
# ==============================================================================
# Copy this file to .env.local or .env.production and populate only your
# real values. Do not commit any real credentials.
# ==============================================================================

# Core app
PORT=3000
NODE_ENV=development
SITE_URL=https://loreafashion.ai.studio
VITE_SITE_URL=https://loreafashion.ai.studio
VITE_BASE_PATH=/
CORS_ALLOWED_ORIGINS=https://USERNAME.github.io/lorea-fashion,https://loreafashion.ai.studio

# Public frontend configuration
VITE_API_URL=
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your_publishable_key_here
# Legacy compatibility: older local configs may still use this name.
VITE_SUPABASE_ANON_KEY=

# Server-side secrets (must stay on the backend only)
AUTH_SECRET=replace_with_a_strong_random_secret
JWT_SECRET=replace_with_a_strong_random_secret
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_PASSWORD=replace_with_a_unique_16_character_or_longer_password
SESSION_EXPIRY_DAYS=7
COOKIE_DOMAIN=

# Email / transactional notifications
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=concierge@example.com
SMTP_PASS=replace_with_smtp_app_password
SMTP_FROM="LORÉA Haute Couture" <concierge@example.com>

# Supabase backend configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key_only_on_server

# Payment / AI / external services
PAYMENT_PROVIDER=
PAYMOB_API_KEY=
PAYMOB_INTEGRATION_ID=
PAYMOB_HMAC_SECRET=
PAYMENT_WEBHOOK_SECRET=
GEMINI_API_KEY=

# Optional: future custom-domain deployment
# SITE_URL=https://www.example.com
# VITE_SITE_URL=https://www.example.com
# VITE_BASE_PATH=/
